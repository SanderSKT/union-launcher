<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UnionLauncher</AssemblyName>
    <RootNamespace>UnionLauncher</RootNamespace>
    <Version>0.2.3</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- Public key is embedded at publish time; no key means updates are disabled. -->
  <ItemGroup Condition="'$(UnionUpdatePublicKeyBase64)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UNIONLauncherUpdatePublicKey</_Parameter1>
      <_Parameter2>$(UnionUpdatePublicKeyBase64)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup Condition="'$(UnionDefaultApiOrigin)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UNIONDefaultApiOrigin</_Parameter1>
      <_Parameter2>$(UnionDefaultApiOrigin)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Exclude nested signing tools and their generated obj/ sources from the GUI app. -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="LauncherWindow.cs" />
    <Compile Include="LauncherSelfUpdater.cs" />
  </ItemGroup>
</Project>
